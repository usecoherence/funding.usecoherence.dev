---
layout: layout.njk
title: Funding Coherence
---
<section class="hero">
  <div>
    <p class="eyebrow">OPEN FUNDING TRACKER</p>
    <h1>Building in public. Funding in public.</h1>
    <p class="lead">Grants, applications, and the road to sustainable development.</p>
  </div>
  <div class="hero-meta">Generated {{ tracker.generatedAt | date }}</div>
</section>

<section class="metrics" aria-label="Summary">
  <div class="metric"><span>Total grants</span><strong>{{ tracker.summary.total }}</strong></div>
  <div class="metric"><span>Applications</span><strong>{{ tracker.summary.applications }}</strong></div>
  <div class="metric"><span>In discussion</span><strong>{{ tracker.summary.inDiscussion }}</strong></div>
  <div class="metric"><span>Funded</span><strong>{{ tracker.summary.funded }}</strong></div>
</section>

<section class="panel">
  <div class="panel-head">
    <h2>Programs</h2>
    <div class="filters">
      <button type="button" data-filter="all" class="active">All</button>
      <button type="button" data-filter="high">High fit</button>
      <button type="button" data-filter="in_discussion">In discussion</button>
      <button type="button" data-filter="funded">Funded</button>
    </div>
  </div>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Priority</th><th>Program</th><th>Fit</th><th>Eligibility</th><th>Status</th><th>Deadline</th><th>Amount</th></tr></thead>
      <tbody>
      {% for grant in tracker.items %}
        {% set application = grant.applications[0] %}
        <tr data-fit="{{ grant.fit }}" data-status="{{ application.status or 'none' }}">
          <td><span class="badge priority p{{ grant.priority }}">{{ grant.priority }}</span></td>
          <td><a class="program" href="/grants/{{ grant.slug }}/">{{ grant.name }}</a><small>{{ grant.programUrl }}</small></td>
          <td><span class="badge {{ grant.fit }}">{{ grant.fit }}</span></td>
          <td><span class="badge {{ grant.eligibility }}">{{ grant.eligibility }}</span></td>
          <td>{{ application.status or "not-started" }}</td>
          <td>{{ application.deadline | date }}</td>
          <td>{% if application.amount %}{{ application.amount }} {{ application.currency }}{% else %}—{% endif %}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
</section>

<script>
  const buttons = document.querySelectorAll("[data-filter]");
  const rows = document.querySelectorAll("tbody tr");
  buttons.forEach((button) => button.addEventListener("click", () => {
    buttons.forEach((item) => item.classList.remove("active"));
    button.classList.add("active");
    const filter = button.dataset.filter;
    rows.forEach((row) => {
      row.hidden = !(filter === "all" || row.dataset.fit === filter || row.dataset.status === filter);
    });
  }));
</script>