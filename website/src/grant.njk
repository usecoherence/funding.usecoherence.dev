---
layout: layout.njk
pagination:
  data: tracker.items
  size: 1
  alias: grant
permalink: "grants/{{ grant.slug }}/index.html"
eleventyComputed:
  title: "{{ grant.name }} — Grant Cockpit"
---
{% set application = grant.applications[0] %}
<nav class="breadcrumb"><a href="/">Programs</a><span>→</span>{{ grant.name }}</nav>
<section class="detail-head">
  <div>
    <p class="eyebrow">{{ grant.programUrl }}</p>
    <h1>{{ grant.name }}</h1>
    <div class="badges">
      <span class="badge priority p{{ grant.priority }}">P{{ grant.priority }}</span>
      <span class="badge {{ grant.fit }}">fit: {{ grant.fit }}</span>
      <span class="badge {{ grant.eligibility }}">eligibility: {{ grant.eligibility }}</span>
      <span class="badge neutral">{{ application.status or "none" }}</span>
    </div>
  </div>
  <div class="quick-links">
    {% if grant.programUrl %}<a href="{{ grant.programUrl }}">Program ↗</a>{% endif %}
  </div>
</section>

<section class="detail-grid">
  <article class="panel prose">
    <h2>Application</h2>
    {% if application %}
    <dl>
      <dt>Status</dt><dd>{{ application.status }}</dd>
      <dt>Amount</dt><dd>{% if application.amount %}{{ application.amount }} {{ application.currency }}{% else %}—{% endif %}</dd>
      <dt>Created</dt><dd>{{ application.createdAt | date }}</dd>
    </dl>
    {% else %}<p class="muted">No application yet.</p>{% endif %}
  </article>

  <aside class="panel command-card">
    <h2>Agent context</h2>
    <code>npm run cli -- grants:show {{ grant.slug }}</code>
    <code>npm run cli -- applications:list</code>
  </aside>
</section>

<section class="panel">
  <h2>Artifacts</h2>
  {% if grant.artifacts.length %}
    <ul class="timeline">
    {% for artifact in grant.artifacts %}
      <li>
        <strong>{{ artifact.artifactType }}</strong>
        <span>{{ artifact.name or "—" }}</span>
        {% if artifact.url %}<a href="{{ artifact.url }}">{{ artifact.url }}</a>{% endif %}
        {% if artifact.content %}<pre>{{ artifact.content }}</pre>{% endif %}
      </li>
    {% endfor %}
    </ul>
  {% else %}<p class="muted">No published artifacts.</p>{% endif %}
</section>