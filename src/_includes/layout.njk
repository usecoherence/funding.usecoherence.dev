<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Coherence funding and grant operations dashboard.">
    <title>{{ title or "Coherence Funding" }}</title>
    {% for css in cssFiles %}
    <link rel="stylesheet" href="/assets/{{ css }}?v={{ cssHash }}">
    {% endfor %}
    <link rel="stylesheet" href="/assets/palettes.css">
    <script>
      (function() {
        var theme = localStorage.getItem("theme");
        if (!theme) {
          theme = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        if (theme === "dark") document.documentElement.classList.add("dark");
        var palette = localStorage.getItem("palette");
        if (palette) document.documentElement.setAttribute("data-palette", palette);
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-row">
        <a class="brand" href="https://usecoherence.dev">Coherence</a>
        <nav class="nav" aria-label="Main navigation">
          <a href="https://usecoherence.dev/docs/">Docs</a>
          <a href="https://usecoherence.dev/blog/">Blog</a>
          <a href="https://usecoherence.dev/cases/">Cases</a>
          <a href="https://usecoherence.dev/ideas/">Ideas</a>
          <a href="/" aria-current="page">Funding</a>
          <a href="https://github.com/usecoherence/coherence">GitHub</a>
        </nav>
      </div>
      <div class="header-rule">
        <div class="header-rule-inner">
          <div class="header-tools">
            <button class="theme-toggle" aria-label="Toggle theme" onclick="toggleTheme()">&#127763;</button>
            <button class="palette-pick" aria-label="Pick a color palette" onclick="randomPalette()">&#127912;</button>
          </div>
        </div>
      </div>
    </header>

    <div class="page-shell">
      <main class="content funding-content">{{ content | safe }}</main>
    </div>

    <script>
      function toggleTheme() {
        var html = document.documentElement;
        var isDark = html.classList.toggle("dark");
        localStorage.setItem("theme", isDark ? "dark" : "light");
      }

      var palettes = ["1", "2", "3"];
      function randomPalette() {
        var html = document.documentElement;
        var current = html.getAttribute("data-palette") || "default";
        var next;
        do {
          next = palettes[Math.floor(Math.random() * palettes.length)];
        } while (next === current && palettes.length > 1);
        html.setAttribute("data-palette", next === "default" ? "" : next);
        localStorage.setItem("palette", next === "default" ? "" : next);
      }
    </script>
    <footer class="site-footer">
      <a class="sponsor-btn" href="https://opencollective.com/coherence">Support Coherence on OpenCollective</a>
    </footer>
  </body>
</html>
